# TODO: Add your GA4 measurement ID (G-XXXXXXXXXX). Blank disables analytics.
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only newsletter settings. Add these in Vercel and redeploy.
# In the Vercel value field, paste only the value (no KEY= prefix or outer quotes).
NUXT_RESEND_API_KEY=
# A sender on your verified Resend domain, e.g. Kamyab <updates@kamyabvalipour.com>
NUXT_RESEND_FROM=
# Blog subscriber segment; use the same ID in Vercel and GitHub Actions.
NUXT_RESEND_SEGMENT_ID=
# Generate with: openssl rand -hex 32
NUXT_NEWSLETTER_SECRET=

# Cloudflare Turnstile: public site key + server-only secret key.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames; production must exclude localhost/127.0.0.1.
NUXT_TURNSTILE_HOSTNAMES=kamyabvalipour.com
